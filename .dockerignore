# Version control and CI
.git
.github

# Agent instructions and local agent state - documentation for humans/agents
# working on the source, with no role at runtime.
AGENTS.md
AGENTS.local.md
CLAUDE.md
CLAUDE.local.md
.claude
.codex
.cursor
.gemini

# OS cruft (picked up when building from a macOS checkout)
.DS_Store

# Python build/cache artifacts
__pycache__
*.pyc
*.egg-info
build
dist

# Local environments
.venv*
venv

# Large local-only artifacts (untracked, not needed at runtime).
# The BirdNET model is downloaded by the `birdnet` dependency on first run,
# so bundled checkpoints are not required in the image.
installers
birdnet_analyzer/checkpoints

# Not needed inside the image
tests
docs
